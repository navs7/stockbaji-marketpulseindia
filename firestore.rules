rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own document (watchlists, follows, prefs, reminder state).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && request.resource.size() < 900 * 1024; // stay under the 1 MiB document limit
    }
    // Shared reference data (events, IPOs, articles): readable by signed-in users, written by admins only.
    // Set the custom claim with the Admin SDK: setCustomUserClaims(uid, { admin: true })
    match /catalog/{doc=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /auditLog/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
